rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function admin() {
      return request.auth != null && request.auth.uid == "cVO9GozjI7O98zuswrSWH2xpfa23";
    }
    function staff() {
      return request.auth != null
        && exists(/databases/$(database)/documents/clubs/avenida-padel/members/$(request.auth.uid))
        && get(/databases/$(database)/documents/clubs/avenida-padel/members/$(request.auth.uid)).data.role == 'staff'
        && get(/databases/$(database)/documents/clubs/avenida-padel/members/$(request.auth.uid)).data.enabled == true;
    }
    function active(generation) {
      let head = get(/databases/$(database)/documents/clubs/avenida-padel/control/current).data;
      return head.generation == generation && head.accessSchemaVersion == 2;
    }
    function validIds(ids) {
      return ids.keys().hasOnly(['entries','clients','products','bookings'])
        && ids.entries is int && ids.entries > 0 && ids.clients is int && ids.clients > 0
        && ids.products is int && ids.products > 0 && ids.bookings is int && ids.bookings > 0;
    }
    function staffRecord(d) {
      let v = d.value;
      return d.keys().hasOnly(['kind','value','scope']) && d.scope == 'staff'
        && v.id is int && v.id > 0
        && ((d.kind == 'entries' && v.keys().hasOnly(['id','kind','activity','monthlyIncome','bookingId','quantity','unitPrice','date','time','client','concept','category','source','paymentMethod','rate','details','cash','transfer','products','amount']) && v.activity == 'padel' && v.kind in ['income','expense']
          && v.monthlyIncome == false && v.amount is number && v.amount >= 0
          && v.cash is number && v.cash >= 0 && v.transfer is number && v.transfer >= 0
          && v.products is number && v.products >= 0 && v.products <= v.amount)
        || (d.kind == 'clients' && v.keys().hasOnly(['id','name']) && v.name is string && v.name.size() > 0 && v.name.size() <= 500)
        || (d.kind == 'products' && v.keys().hasOnly(['id','name','price']) && v.name is string && v.name.size() > 0 && v.name.size() <= 500 && v.price is number && v.price >= 0));
    }
    function staffBooking(d) {
      let v = d.value;
      return d.keys().hasOnly(['kind','value','scope']) && d.kind == 'bookings' && d.scope == 'admin'
        && v.keys().hasOnly(['id','date','time','clientId','clientName','duration','court','status','origin','seriesId'])
        && v.id is int && v.id > 0 && v.clientId is int && v.clientId > 0
        && v.date is string && v.date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$')
        && v.time is string && v.time.matches('^([01][0-9]|2[0-3]):[0-5][0-9]$')
        && v.clientName is string && v.clientName.size() > 0 && v.clientName.size() <= 500
        && v.duration is int && v.duration >= 15 && v.duration <= 480
        && v.court is int && v.court >= 1 && v.court <= 50
        && v.status in ['reserved','played','cancelled'] && v.origin is string && v.origin.size() <= 500
        && v.seriesId is string && v.seriesId.size() <= 500;
    }
    function operable(d) {
      return staffRecord(d) || staffBooking(d);
    }
    function validRecord(id, d) {
      return id == d.kind + '-' + string(d.value.id)
        && (operable(d) || (d.scope == 'admin' && d.keys().hasOnly(['kind','value','scope'])
          && (d.kind == 'entries' && d.value.activity == 'gym')));
    }
    function validMeta(d) {
      return d.keys().hasOnly(['revision','settings','nextIds','scope','accessSchemaVersion','updatedAt'])
        && d.revision is int && d.revision >= 0 && d.scope == 'staff' && d.accessSchemaVersion == 2
        && validIds(d.nextIds)
        && d.settings.keys().hasOnly(['logo','startMonth','gymHistoryImported']);
    }
    function metaBefore(generation) {
      return get(/databases/$(database)/documents/clubs/avenida-padel/datasets/$(generation)/records/_meta).data;
    }
    function metaAfter(generation) {
      return getAfter(/databases/$(database)/documents/clubs/avenida-padel/datasets/$(generation)/records/_meta).data;
    }
    function validCounter(kind, old, newer, generation) {
      return newer == old || (newer == old + 1
        && getAfter(/databases/$(database)/documents/clubs/avenida-padel/datasets/$(generation)/records/$(kind + '-' + string(old))).data.kind == kind
        && getAfter(/databases/$(database)/documents/clubs/avenida-padel/datasets/$(generation)/records/$(kind + '-' + string(old))).data.scope == 'staff');
    }
    function validBookingCounter(old, newer, generation) {
      return newer == old || (newer > old && newer <= old + 53
        && getAfter(/databases/$(database)/documents/clubs/avenida-padel/datasets/$(generation)/records/$('bookings-' + string(old))).data.kind == 'bookings'
        && getAfter(/databases/$(database)/documents/clubs/avenida-padel/datasets/$(generation)/records/$('bookings-' + string(newer - 1))).data.kind == 'bookings');
    }
    function validCreationId(generation, d) {
      let beforeId = metaBefore(generation).nextIds[d.kind];
      let afterId = metaAfter(generation).nextIds[d.kind];
      return d.kind == 'bookings'
        ? (d.value.id >= beforeId && d.value.id < afterId && afterId <= beforeId + 53)
        : (d.value.id == beforeId && afterId == d.value.id + 1);
    }
    function validBookingLink(generation, d) {
      return d.kind != 'entries' || d.value.bookingId == null
        || (d.value.kind == 'income' && d.value.bookingId is int && d.value.bookingId > 0
          && getAfter(/databases/$(database)/documents/clubs/avenida-padel/datasets/$(generation)/records/$('bookings-' + string(d.value.bookingId))).data.kind == 'bookings');
    }
    function staffMetaUpdate(generation) {
      let old = resource.data;
      let newer = request.resource.data;
      return validMeta(newer)
        && newer.diff(old).affectedKeys().hasOnly(['revision','updatedAt','nextIds'])
        && newer.revision == old.revision + 1 && newer.updatedAt == request.time
        && validBookingCounter(old.nextIds.bookings,newer.nextIds.bookings,generation)
        && validCounter('entries',old.nextIds.entries,newer.nextIds.entries,generation)
        && validCounter('clients',old.nextIds.clients,newer.nextIds.clients,generation)
        && validCounter('products',old.nextIds.products,newer.nextIds.products,generation);
    }
    match /clubs/avenida-padel/members/{uid} {
      allow get: if admin() || (request.auth != null && request.auth.uid == uid);
      allow list: if admin();
      allow create, update: if admin() && uid != request.auth.uid
        && request.resource.data.keys().hasOnly(['role','enabled','displayName','email','updatedAt'])
        && request.resource.data.role == 'staff' && request.resource.data.enabled is bool
        && request.resource.data.displayName is string && request.resource.data.displayName.size() <= 100
        && request.resource.data.email is string && request.resource.data.email.size() <= 254;
      allow delete: if admin();
    }
    match /clubs/avenida-padel/control/current {
      allow read: if admin() || staff();
      allow create, update: if admin() && request.resource.data.accessSchemaVersion == 2;
      allow delete: if admin();
    }
    match /clubs/avenida-padel/datasets/{generation}/records/{id} {
      // scope es un atributo de acceso validado en todas las escrituras, también las del administrador.
      // El empleado consulta scope == staff O kind == bookings. Nunca recibe la colección completa ni Gym.
      allow read: if admin() || (staff() && active(generation) && (resource.data.scope == 'staff' || resource.data.kind == 'bookings'));
      allow create: if (admin() && (id == '_meta' ? validMeta(request.resource.data) : validRecord(id,request.resource.data)))
        || (staff() && active(generation) && id != '_meta' && operable(request.resource.data)
          && validRecord(id,request.resource.data)
          && validBookingLink(generation,request.resource.data)
          && validCreationId(generation,request.resource.data)
          && metaAfter(generation).revision == metaBefore(generation).revision + 1);
      allow update: if (admin() && (id == '_meta' ? validMeta(request.resource.data) : validRecord(id,request.resource.data)))
        || (staff() && active(generation) && (id == '_meta' ? staffMetaUpdate(generation)
          : ((resource.data.scope == 'staff' || resource.data.kind == 'bookings') && operable(request.resource.data) && validRecord(id,request.resource.data)
            && request.resource.data.kind == resource.data.kind
            && (request.resource.data.kind != 'entries' || request.resource.data.value.diff(resource.data.value).affectedKeys().hasOnly(['date','time','client','cash','transfer','products','amount','rate','details','concept','category','paymentMethod']))
            && metaAfter(generation).revision == metaBefore(generation).revision + 1)));
      allow delete: if admin();
    }
  }
}
