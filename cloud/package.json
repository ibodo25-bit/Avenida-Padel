{
  "dependencies": {
    "esbuild": "0.25.11",
    "firebase": "13.1.0"
  },
  "name": "avenida-padel-cloud",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.cjs && esbuild src/firebase-client.js --bundle --format=esm --target=es2020 --minify --outfile=public/cloud.js",
    "test": "node --test test/*.test.cjs",
    "test:rules": "node --test rules-test/*.test.cjs",
    "verify:rules": "npx --yes firebase-tools@15.35.0 emulators:exec --config firebase.emulators.json --project demo-avenida-roles --only firestore \"npm run test:rules\""
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "6.0.0",
    "jsdom": "30.1.3"
  }
}
